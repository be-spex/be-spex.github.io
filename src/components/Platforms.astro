---
/**
 * Pinguin and window side by side: marks an app that runs on more than Linux. Linux-only apps get nothing,
 * the site says "for Linux" already. With `text`, the platforms are also written out (app page header).
 */
import { platformText, platformsOf, type App } from "../data/apps";

interface Props {
  app: App;
  text?: boolean;
}
const { app, text = false } = Astro.props;
const platforms = platformsOf(app);
const label = `For ${platformText(app)}`;
---

{platforms.length > 1 && (
  <span class:list={["os", { "os-text": text }]} title={label} aria-label={text ? undefined : label}>
    {platforms.includes("linux") && (
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c-2.3 0-3.6 2-3.6 4.5 0 1.3.3 2.2-.4 3.4C6.6 12 5 14.2 5 16.6c0 .7.2 1.3.5 1.8-.6.3-1.5.6-1.5 1.4 0 1 1.6 1.2 3 1.7 1.1.4 1.8.5 2.4-.2.5-.5 1.4-.7 2.6-.7s2.1.2 2.6.7c.6.7 1.3.6 2.4.2 1.4-.5 3-.7 3-1.7 0-.8-.9-1.1-1.5-1.4.3-.5.5-1.1.5-1.8 0-2.4-1.6-4.6-3-6.7-.7-1.2-.4-2.1-.4-3.4C15.6 4 14.3 2 12 2zm-1.6 3.6c.5 0 .8.5.8 1.1s-.3 1-.8 1-.7-.5-.7-1 .2-1.1.7-1.1zm3.2 0c.5 0 .7.5.7 1.1s-.2 1-.7 1-.8-.5-.8-1 .3-1.1.8-1.1zM12 8.4c.9 0 1.9.5 1.9.9s-1 1.1-1.9 1.1-1.9-.7-1.9-1.1 1-.9 1.9-.9z" /></svg>
    )}
    {platforms.includes("windows") && (
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.3 10.3 4.3v7.1H3zM11.3 4.1 21 2.8v8.6h-9.7zM3 12.5h7.3v7.1L3 18.6zM11.3 12.5H21v8.7l-9.7-1.3z" /></svg>
    )}
    {text && <span>{`for ${platformText(app)}`}</span>}
  </span>
)}
